{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/standards.sh core",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/standards.sh terraform",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/no-ai-attribution.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/vuln-check.py",
            "timeout": 90,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
